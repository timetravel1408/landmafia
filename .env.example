# Google Maps Platform (display only). Restrict the key to your domains in Cloud Console.
GOOGLE_MAPS_API_KEY=your-browser-key
# A Map ID (JavaScript, vector) - style it to hide POI labels.
GOOGLE_MAP_ID=your-map-id

# Leaderboard store. Leave empty to fall back to SQLite (data/leaderboard.sqlite).
REDIS_URL=redis://localhost:6379

# Game server port
PORT=8080

# Comma-separated origins allowed to open WebSockets / call the API
# (e.g. your Cloudflare Pages domain). Empty = allow all.
ALLOWED_ORIGINS=

# --- client build (Cloudflare Pages) ---
# Public URL of the game server when the client is hosted separately.
# Leave empty when the server also serves the client (same origin).
VITE_SERVER_URL=

# --- docker-compose: Cloudflare Tunnel token (optional) ---
CLOUDFLARE_TUNNEL_TOKEN=
